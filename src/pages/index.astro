---
import OpeningCrawl from '../components/OpeningCrawl.astro';
import Starfield from '../components/Starfield.astro';
import { story } from '../data/story';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050609" />
    <meta name="description" content="スクロールで旅する、遠い銀河の物語。タイトルの向こうに、あなたの冒険が待っている。" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{story.title.join(' ')} — A journey through the stars</title>
  </head>
  <body>
    <Starfield />
    <OpeningCrawl story={story} />
  </body>
</html>
