import 'lenis/dist/lenis.css';
import 'gen-interface-jp/700.css';
import '../styles/global.css';

---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
