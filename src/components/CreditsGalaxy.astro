---
// Match the title's fallback stars, without planets, haze, or camera movement.
let seed = 71;
const random = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};
const stars = Array.from({ length: 456 }, () => ({
  x: random() * 1600,
  y: random() * 1000,
  radius: 0.55 + random() * 1.15,
  opacity: 0.35 + random() * 0.6,
}));
---

<div class="credits-galaxy" aria-hidden="true">
  <div class="credits-star-layer">
  <svg class="credits-starfield-fallback" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice">
    {stars.map((star) => <circle cx={star.x} cy={star.y} r={star.radius} fill="#e0e8f1" opacity={star.opacity} />)}
  </svg>
  <canvas id="credits-starfield"></canvas>
  <div class="universe-vignette"></div>
  </div>
</div>
