---
import CreditsGalaxy from './CreditsGalaxy.astro';
import { moonScene } from '../data/moons';
import { planetScene } from '../data/planet';
// Keep a visible base of stars, with WebGL adding depth and parallax on top.
let seed = 71;
const random = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};
const stars = Array.from({ length: 380 }, () => ({
  x: random() * 1600,
  y: random() * 1000,
  radius: 0.55 + random() * 1.15,
  opacity: 0.35 + random() * 0.6,
}));
---

<CreditsGalaxy />
<div class="universe" aria-hidden="true">
  <svg class="starfield-fallback" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice">
    {stars.map((star) => <circle cx={star.x} cy={star.y} r={star.radius} fill="#e0e8f1" opacity={star.opacity} />)}
  </svg>
  <canvas id="starfield"></canvas>
  <div class="moon-scene">
    {moonScene.bodies.map((moon) => (
      <img class={`moon moon-${moon.id}`} src={moonScene.image} width="1873" height="1873" alt="" decoding="async"
        style={`filter: brightness(${moon.brightness}) saturate(${moon.saturation});`} />
    ))}
  </div>
  <div class="planet-scene">
    <img class="planet-limb" src={planetScene.image} width={planetScene.imageSize.width} height={planetScene.imageSize.height} alt="" decoding="async"
      style={`transform: translate(-50%, -${planetScene.horizon * 100}%); mask-image: linear-gradient(to bottom, transparent, #000 ${planetScene.skyFade * 100}%);`} />
  </div>
  <div class="universe-vignette"></div>
</div>

<script>
  import { initStarfield } from '../scripts/starfield';
  const canvas = document.querySelector<HTMLCanvasElement>('#starfield');
  if (canvas) initStarfield(canvas);
</script>
