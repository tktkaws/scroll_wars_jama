---
import type { OpeningStory } from '../data/story';
interface Props { story: OpeningStory }
const { story } = Astro.props;
---

<main id="opening">
  <div class="scroll-journey" data-journey>
    <div class="cinema-stage">
      <section class="intro-scene" data-intro-scene>
        <div class="intro-copy">
          <p class="intro-japanese">{story.prelude}</p>
          <p class="intro-english" lang="en">{story.preludeEnglish}</p>
        </div>
        <button class="begin-button" type="button" data-begin>
          <span>SCROLL TO BEGIN</span>
          <svg width="16" height="22" viewBox="0 0 16 22" fill="none" aria-hidden="true"><path d="M8 1v18M2 13l6 6 6-6" stroke="currentColor" stroke-width="1.2" /></svg>
        </button>
      </section>

      <section class="title-scene" data-title-scene inert>
        <div class="title-projection">
          <h1 class="opening-title" data-title>
            {story.title.map((word) => <span>{word}</span>)}
          </h1>
        </div>
      </section>

      <div class="crawl-viewport" data-crawl-viewport aria-hidden="true">
        <div class="crawl-plane">
          <article class="crawl-text" data-crawl>
            <p class="crawl-episode">{story.episode}</p>
            <h2>{story.chapter}</h2>
            {story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </article>
        </div>
      </div>

      <section class="ending-scene" data-ending inert>
        <p class="eyebrow">THE JOURNEY HAS JUST BEGUN</p>
        <h2>{story.ending}</h2>
        <p>ひとつのスクロールから、どこまでも。</p>
        <button class="restart-button" type="button" data-restart>
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 6a7 7 0 1 1-1 6M4 2v5h5" stroke="currentColor" stroke-width="1.3" /></svg>
          最初から旅する
        </button>
      </section>
    </div>
    <article class="sr-only" aria-label="物語の本文">
      <h2>{story.chapter}</h2>
      {story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </article>
  </div>

  <article class="reader" id="reader" tabindex="-1">
    <p class="reader-prelude">{story.prelude}</p>
    <p class="reader-prelude reader-prelude-english" lang="en">{story.preludeEnglish}</p>
    <h1>{story.title.join(' ')}</h1>
    <p class="eyebrow">{story.episode} / THE OPENING</p>
    <h2>{story.chapter}</h2>
    {story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <p class="reader-ending">{story.ending}</p>
  </article>

  <nav class="chapter-navigation" aria-label="物語の場面" data-chapter-navigation>
    <button class="chapter-stop is-current" type="button" data-chapter="0" aria-label="導入文へ" aria-current="step"><span></span><span class="chapter-name">INTRO</span></button>
    <span class="chapter-line"></span>
    <button class="chapter-stop" type="button" data-chapter="1" aria-label="タイトルへ"><span></span><span class="chapter-name">TITLE</span></button>
    <span class="chapter-line"></span>
    <button class="chapter-stop" type="button" data-chapter="2" aria-label="本文へ"><span></span><span class="chapter-name">STORY</span></button>
    <span class="chapter-line"></span>
    <button class="chapter-stop" type="button" data-chapter="3" aria-label="エンディングへ"><span></span><span class="chapter-name">BEYOND</span></button>
  </nav>

  <footer class="journey-footer" data-footer>
    <div class="footer-actions">
      <button class="reader-toggle" type="button" aria-pressed="false" aria-controls="reader" data-reader-toggle>
        <svg width="15" height="15" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 4h14M3 10h14M3 16h9" stroke="currentColor" stroke-width="1.4" /></svg>
        <span data-reader-label>本文を読む</span>
      </button>
      <div class="footer-caption"><span class="tiny-star">✦</span><span>スクロールで、銀河のその先へ</span></div>
    </div>
    <div class="journey-progress"><span class="progress-caption" data-scene-label>01 — THE INTRO</span><span class="progress-divider"></span><span class="progress-number" data-progress>000</span><span class="progress-unit">%</span></div>
  </footer>
  <div class="progress-track" aria-hidden="true"><div data-progress-bar></div></div>
  <p class="sr-only" role="status" aria-live="polite" data-status>導入文。スクロールするとタイトル、本文の順に進みます。本文を読むボタンで通常の文章表示に切り替えられます。</p>
</main>

<script>
  import { initOpening } from '../scripts/opening';
  initOpening();
</script>
